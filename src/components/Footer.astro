---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner container">
    <p class="muted">© {year} Donghoon Han</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 64px;
    padding: 32px 0 48px;
    box-shadow: rgba(0, 0, 0, 0.08) 0px -1px 0px 0px;
  }
  .footer-inner {
    max-width: var(--wide-max);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer p {
    margin: 0;
    font-size: 13px;
  }
</style>
