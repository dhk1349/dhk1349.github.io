---
import type { Paper } from '../data/papers';
interface Props { paper: Paper }
const { paper } = Astro.props;
const hasHover = !!paper.imageAfter;
---

<article class="paper">
  <div class="thumb" data-hover={hasHover ? 'true' : 'false'}>
    <img class="thumb-base" src={paper.imageBefore} alt="" loading="lazy" />
    {paper.imageAfter && (
      <img class="thumb-hover" src={paper.imageAfter} alt="" loading="lazy" />
    )}
  </div>
  <div class="body">
    <a class="title" href={paper.links[0]?.href ?? '#'}>
      {paper.title}
    </a>
    <p class="authors">
      {paper.authors.map((a, i) => (
        <>
          {a.href ? (
            <a href={a.href} class={a.me ? 'me' : ''}>{a.name}</a>
          ) : (
            <span class={a.me ? 'me' : ''}>{a.name}</span>
          )}
          {a.equal && <sup>*</sup>}
          {i < paper.authors.length - 1 && <span class="sep">, </span>}
        </>
      ))}
    </p>
    <p class="venue">
      <em>{paper.venue}</em>, {paper.year}
      {paper.award && (
        <>
          {' '}<span class="award">{paper.award}</span>
        </>
      )}
    </p>
    <p class="links">
      {paper.links.map((l, i) => (
        <>
          <a href={l.href}>{l.label}</a>
          {i < paper.links.length - 1 && <span class="sep"> · </span>}
        </>
      ))}
    </p>
    <p class="abstract">{paper.abstract}</p>
  </div>
</article>

<style>
  .paper {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--gray-100);
  }
  .paper:first-child { border-top: 0; padding-top: 8px; }

  .thumb {
    position: relative;
    width: 160px;
    height: 120px;
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--ring-light);
    background: var(--gray-50);
  }
  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity .25s ease;
  }
  .thumb-hover { opacity: 0; }
  .thumb[data-hover="true"]:hover .thumb-hover { opacity: 1; }

  .body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

  .title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.36px;
    color: var(--gray-900);
    text-decoration: none;
  }
  .title:hover { color: var(--link); text-decoration: none; }

  .authors {
    font-size: 14px;
    color: var(--gray-700);
    margin: 0;
    line-height: 1.5;
  }
  .authors a { color: var(--gray-700); text-decoration: none; }
  .authors a:hover { color: var(--link); text-decoration: underline; }
  .authors .me { color: var(--gray-900); font-weight: 600; }
  .authors sup { font-size: 0.7em; color: var(--gray-500); }

  .venue {
    font-size: 13px;
    color: var(--gray-600);
    margin: 0;
  }
  .venue em { font-style: italic; color: var(--gray-700); }
  .award {
    display: inline-block;
    margin-left: 4px;
    padding: 1px 8px;
    border-radius: var(--r-pill);
    background: #fff4e5;
    color: #b25b00;
    font-size: 11px;
    font-weight: 500;
    box-shadow: rgba(178, 91, 0, 0.15) 0px 0px 0px 1px inset;
  }

  .links {
    font-size: 13px;
    margin: 2px 0 0;
  }
  .links a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--link);
  }
  .links .sep { color: var(--gray-400); }

  .abstract {
    font-size: 14px;
    color: var(--gray-600);
    line-height: 1.6;
    margin: 8px 0 0;
  }

  @media (max-width: 640px) {
    .paper {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .thumb { width: 100%; height: 180px; }
  }
</style>
