---
import BaseLayout from './BaseLayout.astro';

export type AuthorRow = {
  name: string;
  href?: string;
  affiliation?: string;
  equal?: boolean;
  me?: boolean;
};

export type ResourceLink = {
  label: string;
  href: string;
  meta?: string;
};

interface Props {
  title: string;
  subtitle?: string;
  venue?: string;
  authors: AuthorRow[];
  links: ResourceLink[];
  description?: string;
}

const {
  title,
  subtitle,
  venue,
  authors,
  links,
  description,
} = Astro.props;
---

<BaseLayout title={`${title} · Donghoon Han`} description={description ?? subtitle ?? title}>
  <article class="paper-page">
    <header class="paper-hero">
      <div class="container">
        <p class="eyebrow">{venue}</p>
        <h1 class="paper-title">
          {title}
          {subtitle && <span class="paper-subtitle">{subtitle}</span>}
        </h1>

        <ul class="authors">
          {authors.map((a) => (
            <li class:list={[{ me: a.me }]}>
              {a.href ? (
                <a href={a.href}>{a.name}</a>
              ) : (
                <span>{a.name}</span>
              )}
              {a.equal && <sup>*</sup>}
              {a.affiliation && <span class="aff">{a.affiliation}</span>}
            </li>
          ))}
        </ul>
        {authors.some((a) => a.equal) && (
          <p class="equal-note">* equal contribution</p>
        )}

        <div class="resources">
          {links.map((l) => (
            <a class="resource" href={l.href}>
              <span class="resource-label">{l.label}</span>
              {l.meta && <span class="resource-meta mono">{l.meta}</span>}
            </a>
          ))}
        </div>
      </div>
    </header>

    <div class="paper-body container">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .paper-page { padding-bottom: 32px; }

  .paper-hero {
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--gray-100);
  }
  .container { max-width: 800px; }

  .paper-title {
    font-size: 36px;
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -1.6px;
    margin: 4px 0 20px;
    color: var(--gray-900);
  }
  .paper-subtitle {
    display: block;
    font-size: 22px;
    font-weight: 500;
    color: var(--gray-600);
    letter-spacing: -0.7px;
    margin-top: 8px;
  }

  .authors {
    list-style: none;
    padding: 0;
    margin: 0 0 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-size: 14px;
    color: var(--gray-700);
  }
  .authors li { display: inline-flex; align-items: baseline; gap: 4px; }
  .authors a { color: var(--gray-700); }
  .authors a:hover { color: var(--link); }
  .authors .me a, .authors .me span:first-child { color: var(--gray-900); font-weight: 600; }
  .authors sup { font-size: 0.7em; color: var(--gray-500); }
  .aff {
    font-size: 12px;
    color: var(--gray-500);
    margin-left: 4px;
  }
  .equal-note { font-size: 12px; color: var(--gray-500); margin: 4px 0 0; }

  .resources {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .resource {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--r-md);
    background: var(--white);
    color: var(--gray-900);
    font-size: 14px;
    font-weight: 500;
    box-shadow: var(--ring-light);
    text-decoration: none;
    transition: background .15s ease, box-shadow .15s ease;
  }
  .resource:hover {
    background: var(--gray-50);
    box-shadow: var(--ring);
    text-decoration: none;
  }
  .resource-label { color: var(--gray-900); }
  .resource-meta { color: var(--gray-500); font-size: 12px; }

  .paper-body {
    padding-top: 40px;
  }

  @media (max-width: 640px) {
    .paper-hero { padding: 36px 0 28px; }
    .paper-title { font-size: 28px; letter-spacing: -1.2px; }
    .paper-subtitle { font-size: 18px; letter-spacing: -0.5px; }
  }
</style>

<style is:global>
  /* Shared styles for paper body content */
  .paper-body section + section {
    margin-top: 48px;
  }
  .paper-body h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.7px;
    line-height: 1.3;
    margin: 0 0 16px;
    color: var(--gray-900);
  }
  .paper-body h3 {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.32px;
    margin: 24px 0 8px;
    color: var(--gray-900);
  }
  .paper-body p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--gray-700);
    margin: 0 0 14px;
  }
  .paper-body p:last-child { margin-bottom: 0; }
  .paper-body ol, .paper-body ul {
    font-size: 15px;
    color: var(--gray-700);
    line-height: 1.7;
    padding-left: 22px;
    margin: 0 0 14px;
  }
  .paper-body li { margin: 6px 0; }
  .paper-body li > strong { color: var(--gray-900); }

  .paper-body figure {
    margin: 20px 0;
  }
  .paper-body figure img,
  .paper-body figure video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
    box-shadow: var(--ring-light);
    background: var(--gray-50);
  }
  .paper-body figcaption {
    font-size: 12px;
    color: var(--gray-500);
    margin-top: 8px;
    text-align: center;
    line-height: 1.5;
  }

  .paper-body .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 8px 0 0;
  }
  .paper-body .stat {
    background: var(--white);
    border-radius: var(--r-lg);
    box-shadow: var(--card-shadow);
    padding: 18px 14px;
    text-align: center;
  }
  .paper-body .stat-num {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -1.2px;
    color: var(--gray-900);
    line-height: 1.1;
  }
  .paper-body .stat-label {
    font-size: 11px;
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 6px;
    font-family: var(--font-mono);
  }

  .paper-body .table-wrap {
    overflow-x: auto;
    margin: 14px 0 8px;
    border-radius: var(--r-md);
    box-shadow: var(--ring);
  }
  .paper-body table.results {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    background: var(--white);
  }
  .paper-body table.results th,
  .paper-body table.results td {
    padding: 10px 12px;
    text-align: center;
    border-bottom: 1px solid var(--gray-100);
  }
  .paper-body table.results th {
    background: var(--gray-50);
    font-weight: 600;
    color: var(--gray-700);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--gray-100);
  }
  .paper-body table.results td.method {
    text-align: left;
    font-weight: 500;
    color: var(--gray-900);
  }
  .paper-body table.results tr.divider td {
    border-top: 1px solid var(--gray-200);
  }
  .paper-body table.results tr.highlight td {
    background: var(--gray-50);
    font-weight: 600;
  }
  .paper-body .table-caption {
    font-size: 12px;
    color: var(--gray-500);
    margin-top: 8px;
  }

  .paper-body .citation {
    background: var(--gray-50);
    box-shadow: var(--ring);
    border-radius: var(--r-md);
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--gray-700);
    white-space: pre;
    overflow-x: auto;
    margin: 8px 0 0;
  }

  @media (max-width: 640px) {
    .paper-body .stats { grid-template-columns: repeat(2, 1fr); }
    .paper-body h2 { font-size: 20px; }
  }
</style>
