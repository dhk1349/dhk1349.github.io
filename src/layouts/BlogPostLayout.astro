---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: string;
  readingTime?: string;
  description?: string;
  tags?: string[];
}

const {
  title,
  date,
  readingTime,
  description,
  tags = [],
} = Astro.props;

const isoDate = new Date(date).toISOString();
---

<BaseLayout title={`${title} · Donghoon Han`} description={description ?? title}>
  <article class="post">
    <header class="post-hero container">
      <p class="eyebrow">
        <a href="/blog">← Blog</a>
      </p>
      <h1 class="post-title">{title}</h1>
      <p class="post-meta mono">
        <time datetime={isoDate}>{date}</time>
        {readingTime && (<><span class="dot">·</span><span>{readingTime}</span></>)}
      </p>
      {tags.length > 0 && (
        <ul class="post-tags">
          {tags.map((t) => <li class="pill neutral">{t}</li>)}
        </ul>
      )}
    </header>

    <div class="post-body container">
      <slot />
    </div>

    <footer class="post-footer container">
      <a class="btn btn-ghost" href="/blog">← All posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post { padding-bottom: 32px; }
  .container { max-width: 720px; }

  .post-hero {
    padding: 56px 0 28px;
  }
  .post-hero .eyebrow { margin: 0 0 20px; }
  .post-hero .eyebrow a { color: var(--gray-500); text-decoration: none; }
  .post-hero .eyebrow a:hover { color: var(--gray-900); }

  .post-title {
    font-size: 36px;
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -1.6px;
    margin: 0;
    color: var(--gray-900);
  }
  .post-meta {
    margin: 16px 0 0;
    font-size: 12px;
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .dot { color: var(--gray-400); }

  .post-tags {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .post-body {
    padding-top: 24px;
    border-top: 1px solid var(--gray-100);
    margin-top: 24px;
  }

  .post-footer {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--gray-100);
  }

  @media (max-width: 640px) {
    .post-hero { padding: 36px 0 20px; }
    .post-title { font-size: 28px; letter-spacing: -1.2px; }
  }
</style>

<style is:global>
  /* Long-form prose styles for blog body */
  .post-body p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--gray-700);
    margin: 0 0 18px;
  }
  .post-body p:last-child { margin-bottom: 0; }
  .post-body h2 {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.96px;
    line-height: 1.3;
    margin: 40px 0 14px;
    color: var(--gray-900);
  }
  .post-body h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.4px;
    margin: 28px 0 10px;
    color: var(--gray-900);
  }
  .post-body ul, .post-body ol {
    font-size: 17px;
    line-height: 1.75;
    color: var(--gray-700);
    padding-left: 24px;
    margin: 0 0 18px;
  }
  .post-body li { margin: 6px 0; }
  .post-body strong { color: var(--gray-900); font-weight: 600; }
  .post-body em { font-style: italic; }
  .post-body a { color: var(--link); }

  .post-body figure {
    margin: 28px 0;
  }
  .post-body figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
    box-shadow: var(--ring-light);
    background: var(--gray-50);
  }
  .post-body figcaption {
    font-size: 13px;
    color: var(--gray-500);
    margin-top: 8px;
    text-align: center;
    line-height: 1.5;
  }

  .post-body blockquote {
    margin: 24px 0;
    padding: 4px 0 4px 18px;
    border-left: 2px solid var(--gray-200);
    color: var(--gray-600);
    font-style: italic;
  }
  .post-body blockquote p { font-size: 17px; }

  .post-body :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--gray-50);
    color: var(--gray-900);
    box-shadow: var(--ring);
  }
  .post-body pre {
    background: var(--gray-50);
    border-radius: var(--r-md);
    box-shadow: var(--ring);
    padding: 16px 18px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.6;
    margin: 18px 0;
  }
  .post-body pre code {
    font-family: var(--font-mono);
    background: none;
    padding: 0;
    box-shadow: none;
    color: var(--gray-900);
  }

  .post-body .callout {
    margin: 22px 0;
    padding: 14px 18px;
    border-radius: var(--r-md);
    background: var(--gray-50);
    box-shadow: var(--ring);
    font-size: 15px;
    line-height: 1.6;
    color: var(--gray-700);
  }
  .post-body .callout-title {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--gray-500);
    margin: 0 0 6px;
  }
  .post-body .callout p { font-size: 15px; margin: 0; }

  .post-body hr {
    border: 0;
    border-top: 1px solid var(--gray-100);
    margin: 36px 0;
  }

  .post-body .footnote {
    font-size: 13px;
    color: var(--gray-500);
    line-height: 1.6;
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--gray-100);
  }

  @media (max-width: 640px) {
    .post-body p, .post-body ul, .post-body ol { font-size: 16px; }
    .post-body h2 { font-size: 22px; }
  }
</style>
