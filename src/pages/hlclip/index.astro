const authors = [
  { name: 'Donghoon Han', href: 'https://dhk1349.github.io/', equal: true, me: true },
  { name: 'Seunghyeon Seo', href: 'https://scholar.google.com/citations?user=LL9u-5IAAAAJ&hl=en&oi=ao', equal: true },
  { name: 'Eunhwan Park', href: 'https://scholar.google.com/citations?user=FZS2KD8AAAAJ&hl=ko&oi=ao' },
  { name: 'SeongUk Nam' },
  { name: 'Nojun Kwak', href: 'http://mipal.snu.ac.kr/index.php/Nojun_Kwak' },
];

const links = [
  { label: 'arXiv', href: 'https://arxiv.org/abs/2404.01745', meta: '2404.01745' },
  { label: 'Paper (PDF)', href: 'https://openaccess.thecvf.com/content/CVPR2024W/ELVM/papers/Han_Unleash_the_Potential_of_CLIP_for_Video_Highlight_Detection_CVPRW_2024_paper.pdf' },
