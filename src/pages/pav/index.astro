          <tr><td class="method">h = 10</td><td>89.8</td><td>92.8</td><td>88.0</td><td>79.2</td><td>87.45</td><td>19.2</td></tr>
          <tr><td class="method">h = 50</td><td>53.2</td><td>55.0</td><td>72.4</td><td>46.6</td><td>56.80</td><td>5.4</td></tr>
          <tr><td class="method">AutoHorizon</td><td>95.6</td><td>97.2</td><td>92.4</td><td>92.6</td><td>94.45</td><td>12.7</td></tr>
